{
  "id": "M8",
  "name": "healthcare_appointment",
  "level": "medium",
  "description": "医疗预约分析场景，包含科室、医生、预约和就诊数据",
  "data_file": "tests/agent_contract/data/M8_healthcare.xlsx",
  "source": {
    "sheet": "就诊记录",
    "header_row": 1
  },
  "user_prompt": "分析各科室各医生的门诊情况，要求：筛选预约状态=已就诊，按科室和医生姓名分组，计算接诊人数、平均就诊时长（分钟）和复诊患者数，按接诊人数降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "completed", "field": "预约状态", "operator": "eq", "value": "已就诊"}
    ],
    "dimensions": [
      {"id": "dept", "field": "科室", "output_name": "科室"},
      {"id": "doctor", "field": "医生姓名", "output_name": "医生姓名"}
    ],
    "metrics": [
      {"id": "patient_count", "function": "count", "mode": "rows", "output_name": "接诊人数"},
      {"id": "avg_duration", "function": "average", "field": "就诊时长", "output_name": "平均就诊时长"},
      {"id": "return_count", "function": "sum", "field": "复诊标记", "output_name": "复诊患者数"}
    ],
    "sort": [
      {"by": "patient_count", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "预约状态 == '已就诊'",
    "group_by": ["科室", "医生姓名"],
    "aggregations": {
      "接诊人数": "size",
      "就诊时长": "mean",
      "复诊标记": "sum"
    },
    "sort_by": [{"field": "接诊人数", "ascending": false}],
    "expected_row_count": 32,
    "expected_total": 4500,
    "sample_rows": [
      {"科室": "内科", "医生姓名": "张医生", "接诊人数": 285, "平均就诊时长": 18.5, "复诊患者数": 120},
      {"科室": "外科", "医生姓名": "李医生", "接诊人数": 248, "平均就诊时长": 22.8, "复诊患者数": 95},
      {"科室": "儿科", "医生姓名": "王医生", "接诊人数": 232, "平均就诊时长": 15.2, "复诊患者数": 88}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "healthcare_analysis",
    "data_volume": "medium"
  },
  "tags": ["medium", "healthcare", "appointment", "doctor_performance"]
}
