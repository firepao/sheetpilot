{
  "id": "S9",
  "name": "simple_two_dimensions",
  "level": "simple",
  "description": "简单双维度分组场景，测试二维分组聚合",
  "data_file": "tests/agent_contract/data/S9_two_dimensions.xlsx",
  "source": {
    "sheet": "销售记录",
    "header_row": 1
  },
  "user_prompt": "统计各城市各产品的销售额，要求：按城市和产品名称分组，计算销售总额，按城市升序、销售总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "city", "field": "城市", "output_name": "城市"},
      {"id": "product", "field": "产品名称", "output_name": "产品名称"}
    ],
    "metrics": [
      {"id": "total_sales", "function": "sum", "field": "销售额", "output_name": "销售总额"}
    ],
    "sort": [
      {"by": "city", "direction": "asc"},
      {"by": "total_sales", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["城市", "产品名称"],
    "aggregations": {
      "销售额": "sum"
    },
    "sort_by": [
      {"field": "城市", "ascending": true},
      {"field": "销售总额", "ascending": false}
    ],
    "expected_row_count": 20,
    "expected_total": 200000,
    "sample_rows": [
      {"城市": "北京", "产品名称": "产品A", "销售总额": 35000},
      {"城市": "北京", "产品名称": "产品B", "销售总额": 28000},
      {"城市": "上海", "产品名称": "产品C", "销售总额": 32000}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "two_dimensions",
    "data_volume": "small"
  },
  "tags": ["simple", "two_dimensions", "multi_sort", "basic"]
