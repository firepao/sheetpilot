{
  "id": "M4",
  "name": "time_period_aggregation",
  "level": "medium",
  "description": "时间段汇总场景，按周/月/季度聚合，测试时间维度分组能力",
  "data_file": "tests/agent_contract/data/M4_time_period.xlsx",
  "source": {
    "sheet": "销售流水",
    "header_row": 1
  },
  "user_prompt": "统计2024年各月的销售情况，要求：筛选2024年数据，按月份分组（格式为2024-01、2024-02等），计算销售总额、订单数量和平均订单金额，按月份升序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "year_2024", "field": "年份", "operator": "eq", "value": 2024}
    ],
    "dimensions": [
      {"id": "month", "field": "月份", "output_name": "月份"}
    ],
    "metrics": [
      {"id": "total_sales", "function": "sum", "field": "销售额", "output_name": "销售总额"},
      {"id": "order_count", "function": "count", "mode": "rows", "output_name": "订单数量"},
      {"id": "avg_amount", "function": "average", "field": "销售额", "output_name": "平均订单金额"}
    ],
    "sort": [
      {"by": "month", "direction": "asc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["月份"],
    "aggregations": {
      "销售额": ["sum", "mean"],
      "订单数量": "count"
    },
    "sort_by": [{"field": "月份", "ascending": true}],
    "expected_row_count": 12,
    "expected_total": 3600000,
    "sample_rows": [
      {"月份": "2024-01", "销售总额": 285000, "订单数量": 320, "平均订单金额": 890.63},
      {"月份": "2024-02", "销售总额": 298000, "订单数量": 340, "平均订单金额": 876.47},
      {"月份": "2024-03", "销售总额": 312000, "订单数量": 365, "平均订单金额": 854.79}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "time_aggregation",
    "data_volume": "medium"
  },
  "tags": ["medium", "time_series", "monthly_aggregation", "trend_analysis"]
}
