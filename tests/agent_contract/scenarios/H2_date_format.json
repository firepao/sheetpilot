{
  "id": "H2",
  "name": "date_format_ambiguity",
  "level": "hard",
  "description": "日期格式歧义场景，同一列存在多种日期格式（2024-01-15、2024/01/15、20240115）",
  "data_file": "tests/agent_contract/data/H2_date_format.xlsx",
  "source": {
    "sheet": "订单记录",
    "header_row": 1
  },
  "user_prompt": "统计2024年各月的订单情况，要求：按月份分组，计算订单总额和订单数量，按月份升序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto",
    "notes": "Runtime需要正确解析多种日期格式并提取月份"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "month", "field": "月份", "output_name": "月份"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "订单金额", "output_name": "订单总额"},
      {"id": "order_count", "function": "count", "mode": "rows", "output_name": "订单数量"}
    ],
    "sort": [
      {"by": "month", "direction": "asc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_to_datetime",
    "date_field": "订单日期",
    "extract_field": "month",
    "group_by": ["月份"],
    "aggregations": {
      "订单金额": "sum",
      "订单数量": "size"
    },
    "sort_by": [{"field": "月份", "ascending": true}],
    "expected_row_count": 12,
    "expected_total": 2400000,
    "sample_rows": [
      {"月份": "2024-01", "订单总额": 185000, "订单数量": 420},
      {"月份": "2024-02", "订单总额": 195000, "订单数量": 438},
      {"月份": "2024-03", "订单总额": 210000, "订单数量": 465}
    ],
    "date_formats": ["2024-01-15", "2024/01/15", "20240115"]
  },
  "difficulty_factors": {
    "data_quality": "format_inconsistent",
    "field_binding": "exact_match",
    "business_logic": "date_parsing_multi_format",
    "data_volume": "medium"
  },
  "tags": ["hard", "date_format", "format_ambiguity", "time_series"]
}
