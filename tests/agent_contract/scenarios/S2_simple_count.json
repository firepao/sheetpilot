{
  "id": "S2",
  "name": "simple_count_rows",
  "level": "simple",
  "description": "最简单的行数统计场景，测试count.rows基础功能",
  "data_file": "tests/agent_contract/data/S2_simple_count.xlsx",
  "source": {
    "sheet": "客户列表",
    "header_row": 1
  },
  "user_prompt": "统计各城市的客户数量，要求：按城市分组，计算客户数量，按客户数量降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "city", "field": "城市", "output_name": "城市"}
    ],
    "metrics": [
      {"id": "customer_count", "function": "count", "mode": "rows", "output_name": "客户数量"}
    ],
    "sort": [
      {"by": "customer_count", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["城市"],
    "aggregations": {
      "客户数量": "size"
    },
    "sort_by": [{"field": "客户数量", "ascending": false}],
    "expected_row_count": 8,
    "expected_total": 200,
    "sample_rows": [
      {"城市": "北京", "客户数量": 45},
      {"城市": "上海", "客户数量": 38},
      {"城市": "广州", "客户数量": 32}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "count_rows",
    "data_volume": "small"
  },
  "tags": ["simple", "count", "groupby", "basic"]
}
