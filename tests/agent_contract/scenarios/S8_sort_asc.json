{
  "id": "S8",
  "name": "simple_sort_asc",
  "level": "simple",
  "description": "简单升序排序场景，测试asc排序功能",
  "data_file": "tests/agent_contract/data/S8_sort_asc.xlsx",
  "source": {
    "sheet": "学生成绩",
    "header_row": 1
  },
  "user_prompt": "统计各学生的总分，要求：按学生姓名分组，计算总分（各科成绩之和），按总分升序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "student", "field": "学生姓名", "output_name": "学生姓名"}
    ],
    "metrics": [
      {"id": "total_score", "function": "sum", "field": "成绩", "output_name": "总分"}
    ],
    "sort": [
      {"by": "total_score", "direction": "asc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["学生姓名"],
    "aggregations": {
      "成绩": "sum"
    },
    "sort_by": [{"field": "总分", "ascending": true}],
    "expected_row_count": 30,
    "sample_rows": [
      {"学生姓名": "张三", "总分": 245},
      {"学生姓名": "李四", "总分": 258},
      {"学生姓名": "王五", "总分": 267}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "sort_asc",
    "data_volume": "small"
  },
  "tags": ["simple", "sort_asc", "education", "basic"]
}
