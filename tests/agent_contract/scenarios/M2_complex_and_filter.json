{
  "id": "M2",
  "name": "complex_and_filter",
  "level": "medium",
  "description": "多条件AND过滤场景，3-4个过滤条件组合，测试复杂筛选逻辑",
  "data_file": "tests/agent_contract/data/M2_complex_and_filter.xlsx",
  "source": {
    "sheet": "订单数据",
    "header_row": 1
  },
  "user_prompt": "统计优质订单的情况，要求：筛选条件为订单金额≥1000 且 客户评分≥4.5 且 配送方式=快递 且 订单状态=已完成，按产品类别分组，计算订单总额、订单数量和平均订单金额，按订单总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "amount_filter", "field": "订单金额", "operator": "gte", "value": 1000},
      {"id": "rating_filter", "field": "客户评分", "operator": "gte", "value": 4.5},
      {"id": "delivery_filter", "field": "配送方式", "operator": "eq", "value": "快递"},
      {"id": "status_filter", "field": "订单状态", "operator": "eq", "value": "已完成"}
    ],
    "dimensions": [
      {"id": "category", "field": "产品类别", "output_name": "产品类别"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "订单金额", "output_name": "订单总额"},
      {"id": "order_count", "function": "count", "mode": "rows", "output_name": "订单数量"},
      {"id": "avg_amount", "function": "average", "field": "订单金额", "output_name": "平均订单金额"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "(订单金额 >= 1000) & (客户评分 >= 4.5) & (配送方式 == '快递') & (订单状态 == '已完成')",
    "group_by": ["产品类别"],
    "aggregations": {
      "订单金额": ["sum", "mean"],
      "订单数量": "count"
    },
    "sort_by": [{"field": "订单总额", "ascending": false}],
    "expected_row_count": 5,
    "expected_total": 850000,
    "sample_rows": [
      {"产品类别": "电子产品", "订单总额": 320000, "订单数量": 180, "平均订单金额": 1777.78},
      {"产品类别": "家居用品", "订单总额": 245000, "订单数量": 165, "平均订单金额": 1484.85}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "multi_condition_and",
    "data_volume": "medium"
  },
  "tags": ["medium", "multi_filter", "and_logic", "rating"]
}
