{
  "id": "M5",
  "name": "customer_segment_analysis",
  "level": "medium",
  "description": "客户分层分析场景，基于消费金额区间分组，测试区间判断和聚合能力",
  "data_file": "tests/agent_contract/data/M5_customer_segment.xlsx",
  "source": {
    "sheet": "客户消费",
    "header_row": 1
  },
  "user_prompt": "统计各客户等级的消费情况，要求：按客户等级（普通会员、银卡会员、金卡会员、钻石会员）分组，计算客户数量、消费总额和平均客户价值，按消费总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "level", "field": "客户等级", "output_name": "客户等级"}
    ],
    "metrics": [
      {"id": "customer_count", "function": "count", "mode": "non_empty", "field": "客户编号", "output_name": "客户数量"},
      {"id": "total_amount", "function": "sum", "field": "消费金额", "output_name": "消费总额"},
      {"id": "avg_value", "function": "average", "field": "消费金额", "output_name": "平均客户价值"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["客户等级"],
    "aggregations": {
      "客户编号": "nunique",
      "消费金额": ["sum", "mean"]
    },
    "sort_by": [{"field": "消费总额", "ascending": false}],
    "expected_row_count": 4,
    "expected_total": 1800000,
    "sample_rows": [
      {"客户等级": "钻石会员", "客户数量": 45, "消费总额": 680000, "平均客户价值": 15111.11},
      {"客户等级": "金卡会员", "客户数量": 120, "消费总额": 560000, "平均客户价值": 4666.67},
      {"客户等级": "银卡会员", "客户数量": 280, "消费总额": 380000, "平均客户价值": 1357.14}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "segmentation",
    "data_volume": "medium"
  },
  "tags": ["medium", "customer_segment", "membership_level", "value_analysis"]
}
