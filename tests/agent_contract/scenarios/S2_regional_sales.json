{
  "id": "S2",
  "name": "regional_sales_summary",
  "level": "simple",
  "description": "双维度分组（区域+产品类别），无过滤条件，验证基础二维聚合能力",
  "data_file": "tests/agent_contract/data/S2_regional_sales.xlsx",
  "source": {
    "sheet": "销售记录",
    "header_row": 1
  },
  "user_prompt": "统计各区域、各产品类别的销售情况，要求：按区域分组，再按产品类别细分，计算销售总额，按区域和销售额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [],
    "dimensions": [
      {"id": "region", "field": "区域", "output_name": "区域"},
      {"id": "category", "field": "产品类别", "output_name": "产品类别"}
    ],
    "metrics": [
      {"id": "total_sales", "function": "sum", "field": "销售额", "output_name": "销售总额"}
    ],
    "sort": [
      {"by": "region", "direction": "asc"},
      {"by": "total_sales", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_groupby",
    "group_by": ["区域", "产品类别"],
    "aggregations": {"销售额": "sum"},
    "sort_by": [{"field": "区域", "ascending": true}, {"field": "销售总额", "ascending": false}],
    "expected_row_count": 12,
    "expected_total": 480000,
    "sample_rows": [
      {"区域": "华北", "产品类别": "电子产品", "销售总额": 85000},
      {"区域": "华北", "产品类别": "家居用品", "销售总额": 52000},
      {"区域": "华东", "产品类别": "电子产品", "销售总额": 120000}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "straightforward",
    "data_volume": "small"
  },
  "tags": ["simple", "multi_dimension", "no_filter", "baseline"]
}
