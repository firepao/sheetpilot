{
  "id": "S7",
  "name": "numeric_filter_basic",
  "level": "simple",
  "description": "基础数值过滤场景：gte操作符",
  "data_file": "tests/agent_contract/data/S7_numeric_filter.xlsx",
  "source": {
    "sheet": "订单数据",
    "header_row": 1
  },
  "user_prompt": "统计金额大于等于1000元的订单各城市的订单总额",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "high_value", "field": "订单金额", "operator": "gte", "value": 1000}
    ],
    "dimensions": [
      {"id": "city", "field": "城市", "output_name": "城市"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "订单金额", "output_name": "订单总额"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "订单金额 >= 1000",
    "group_by": ["城市"],
    "aggregations": {
      "订单金额": "sum"
    },
    "sort_by": [{"field": "订单总额", "ascending": false}],
    "expected_row_count": 10,
    "expected_total": 520000,
    "sample_rows": [
      {"城市": "北京", "订单总额": 95000},
      {"城市": "上海", "订单总额": 82000},
      {"城市": "深圳", "订单总额": 68000}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "numeric_filter",
    "data_volume": "small"
  },
  "tags": ["simple", "numeric_filter", "gte_operator"]
}
