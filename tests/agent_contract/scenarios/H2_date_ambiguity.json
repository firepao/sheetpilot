{
  "id": "H2",
  "name": "date_format_ambiguity",
  "level": "hard",
  "description": "日期格式不一致场景，同一列混用YYYY-MM-DD和MM/DD/YYYY格式，测试字段识别能力",
  "data_file": "tests/agent_contract/data/H2_date_ambiguity.xlsx",
  "source": {
    "sheet": "交易记录",
    "header_row": 1
  },
  "user_prompt": "统计2024年各月的交易情况，要求：筛选2024年的记录，按月份分组，计算交易总额和交易笔数，按月份升序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 2,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto",
    "expected_clarifications": [
      "交易日期列格式不一致，部分为YYYY-MM-DD，部分为MM/DD/YYYY，需要Agent识别并告知用户"
    ]
  },
  "task_request_template": {
    "filters": [
      {"id": "year_2024", "field": "交易日期", "operator": "gte", "value": "2024-01-01"},
      {"id": "year_2024_end", "field": "交易日期", "operator": "lte", "value": "2024-12-31"}
    ],
    "dimensions": [
      {"id": "month", "field": "月份", "output_name": "月份"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "交易金额", "output_name": "交易总额"},
      {"id": "tx_count", "function": "count", "mode": "rows", "output_name": "交易笔数"}
    ],
    "sort": [
      {"by": "month", "direction": "asc"}
    ]
  },
  "oracle_params": {
    "method": "manual_verification",
    "note": "由于日期格式混乱，需要人工验证Agent是否正确识别日期字段或要求用户清洗数据",
    "expected_behavior": "CAPABILITY_UNSUPPORTED 或要求用户预处理",
    "expected_row_count": 12,
    "sample_rows": [
      {"月份": "2024-01", "交易总额": 125000, "交易笔数": 45},
      {"月份": "2024-02", "交易总额": 98000, "交易笔数": 38}
    ]
  },
  "difficulty_factors": {
    "data_quality": "dirty",
    "field_binding": "format_inconsistent",
    "business_logic": "date_extraction",
    "data_volume": "medium"
  },
  "tags": ["hard", "date_ambiguity", "format_inconsistent", "capability_boundary"]
}
