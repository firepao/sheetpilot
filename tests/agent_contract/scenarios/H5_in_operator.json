{
  "id": "H5",
  "name": "in_operator_multi_value",
  "level": "hard",
  "description": "IN运算符多值过滤场景，测试in操作符和多值匹配能力",
  "data_file": "tests/agent_contract/data/H5_in_operator.xlsx",
  "source": {
    "sheet": "订单数据",
    "header_row": 1
  },
  "user_prompt": "统计核心城市（北京、上海、广州、深圳）的订单情况，要求：筛选城市在这四个城市中的订单，按城市分组，计算订单总额、订单数量和平均订单金额，按订单总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "core_cities", "field": "城市", "operator": "in", "value": ["北京", "上海", "广州", "深圳"]}
    ],
    "dimensions": [
      {"id": "city", "field": "城市", "output_name": "城市"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "订单金额", "output_name": "订单总额"},
      {"id": "order_count", "function": "count", "mode": "rows", "output_name": "订单数量"},
      {"id": "avg_amount", "function": "average", "field": "订单金额", "output_name": "平均订单金额"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "城市.isin(['北京', '上海', '广州', '深圳'])",
    "group_by": ["城市"],
    "aggregations": {
      "订单金额": ["sum", "mean"],
      "订单数量": "size"
    },
    "sort_by": [{"field": "订单总额", "ascending": false}],
    "expected_row_count": 4,
    "expected_total": 680000,
    "sample_rows": [
      {"城市": "北京", "订单总额": 220000, "订单数量": 280, "平均订单金额": 785.71},
      {"城市": "上海", "订单总额": 195000, "订单数量": 250, "平均订单金额": 780.0},
      {"城市": "广州", "订单总额": 155000, "订单数量": 200, "平均订单金额": 775.0}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "in_operator",
    "data_volume": "medium"
  },
  "tags": ["hard", "in_operator", "multi_value_filter", "core_cities"]
}
