{
  "id": "H4",
  "name": "complex_multi_condition",
  "level": "hard",
  "description": "复杂多条件场景，5个过滤条件+3个维度+5个指标",
  "data_file": "tests/agent_contract/data/H4_complex_multi.xlsx",
  "source": {
    "sheet": "交易数据",
    "header_row": 1
  },
  "user_prompt": "分析高价值客户的核心品类购买行为，要求：筛选会员等级=钻石或黄金、订单金额≥500、支付状态=已支付、配送状态≠已退货、评价分数≥4分，按客户城市、一级类目和二级类目分组，计算订单总额、订单数量、客户数（去重）、平均订单金额和好评订单数，按订单总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "vip_level", "field": "会员等级", "operator": "in", "value": ["钻石", "黄金"]},
      {"id": "high_value", "field": "订单金额", "operator": "gte", "value": 500},
      {"id": "paid", "field": "支付状态", "operator": "eq", "value": "已支付"},
      {"id": "not_returned", "field": "配送状态", "operator": "ne", "value": "已退货"},
      {"id": "good_rating", "field": "评价分数", "operator": "gte", "value": 4}
    ],
    "dimensions": [
      {"id": "city", "field": "客户城市", "output_name": "客户城市"},
      {"id": "cat1", "field": "一级类目", "output_name": "一级类目"},
      {"id": "cat2", "field": "二级类目", "output_name": "二级类目"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "订单金额", "output_name": "订单总额"},
      {"id": "order_count", "function": "count", "mode": "rows", "output_name": "订单数量"},
      {"id": "customer_count", "function": "count", "mode": "non_empty", "field": "客户ID", "output_name": "客户数"},
      {"id": "avg_amount", "function": "average", "field": "订单金额", "output_name": "平均订单金额"},
      {"id": "good_review_count", "function": "sum", "field": "好评标记", "output_name": "好评订单数"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "(会员等级.isin(['钻石', '黄金'])) & (订单金额 >= 500) & (支付状态 == '已支付') & (配送状态 != '已退货') & (评价分数 >= 4)",
    "group_by": ["客户城市", "一级类目", "二级类目"],
    "aggregations": {
      "订单金额": ["sum", "mean"],
      "订单数量": "size",
      "客户ID": "count",
      "好评标记": "sum"
    },
    "sort_by": [{"field": "订单总额", "ascending": false}],
    "expected_row_count": 48,
    "expected_total": 3800000,
    "sample_rows": [
      {"客户城市": "北京", "一级类目": "数码", "二级类目": "手机", "订单总额": 285000, "订单数量": 320, "客户数": 280, "平均订单金额": 890.63, "好评订单数": 305},
      {"客户城市": "上海", "一级类目": "服饰", "二级类目": "女装", "订单总额": 245000, "订单数量": 380, "客户数": 320, "平均订单金额": 644.74, "好评订单数": 365},
      {"客户城市": "深圳", "一级类目": "家电", "二级类目": "冰箱", "订单总额": 220000, "订单数量": 180, "客户数": 165, "平均订单金额": 1222.22, "好评订单数": 172}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "complex_multi_condition",
    "data_volume": "large"
  },
  "tags": ["hard", "multi_condition", "multi_dimension", "high_complexity"]
}
