{
  "id": "S7",
  "name": "simple_two_filters",
  "level": "simple",
  "description": "简单双条件过滤场景，测试AND组合过滤",
  "data_file": "tests/agent_contract/data/S7_two_filters.xlsx",
  "source": {
    "sheet": "产品销售",
    "header_row": 1
  },
  "user_prompt": "统计高价且有库存的产品销售额，要求：筛选单价≥100且库存数量>0的产品，按品牌分组，计算销售总额，按销售总额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "high_price", "field": "单价", "operator": "gte", "value": 100},
      {"id": "in_stock", "field": "库存数量", "operator": "gt", "value": 0}
    ],
    "dimensions": [
      {"id": "brand", "field": "品牌", "output_name": "品牌"}
    ],
    "metrics": [
      {"id": "total_sales", "function": "sum", "field": "销售额", "output_name": "销售总额"}
    ],
    "sort": [
      {"by": "total_sales", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "(单价 >= 100) & (库存数量 > 0)",
    "group_by": ["品牌"],
    "aggregations": {
      "销售额": "sum"
    },
    "sort_by": [{"field": "销售总额", "ascending": false}],
    "expected_row_count": 4,
    "expected_total": 125000,
    "sample_rows": [
      {"品牌": "品牌A", "销售总额": 48000},
      {"品牌": "品牌B", "销售总额": 38000},
      {"品牌": "品牌C", "销售总额": 25000}
    ]
  },
  "difficulty_factors": {
    "data_quality": "clean",
    "field_binding": "exact_match",
    "business_logic": "two_filters_and",
    "data_volume": "small"
  },
  "tags": ["simple", "two_filters", "and_logic", "basic"]
}
