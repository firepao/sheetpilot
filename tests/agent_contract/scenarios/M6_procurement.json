{
  "id": "M6",
  "name": "supply_chain_procurement",
  "level": "medium",
  "description": "供应链采购分析场景，包含供应商、采购金额和交付数据",
  "data_file": "tests/agent_contract/data/M6_procurement.xlsx",
  "source": {
    "sheet": "采购记录",
    "header_row": 1
  },
  "user_prompt": "分析各供应商的采购表现，要求：筛选采购状态=已到货且质检状态=合格的记录，按供应商名称和物料类别分组，计算采购总金额、采购次数和平均采购金额，按采购总金额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "arrived", "field": "采购状态", "operator": "eq", "value": "已到货"},
      {"id": "qualified", "field": "质检状态", "operator": "eq", "value": "合格"}
    ],
    "dimensions": [
      {"id": "supplier", "field": "供应商名称", "output_name": "供应商名称"},
      {"id": "category", "field": "物料类别", "output_name": "物料类别"}
    ],
    "metrics": [
      {"id": "total_amount", "function": "sum", "field": "采购金额", "output_name": "采购总金额"},
      {"id": "purchase_count", "function": "count", "mode": "rows", "output_name": "采购次数"},
      {"id": "avg_amount", "function": "average", "field": "采购金额", "output_name": "平均采购金额"}
    ],
    "sort": [
      {"by": "total_amount", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "(采购状态 == '已到货') & (质检状态 == '合格')",
    "group_by": ["供应商名称", "物料类别"],
    "aggregations": {
      "采购金额": ["sum", "mean"],
      "采购次数": "size"
    },
    "sort_by": [{"field": "采购总金额", "ascending": false}],
    "expected_row_count": 28,
    "expected_total": 3200000,
    "sample_rows": [
      {"供应商名称": "供应商A", "物料类别": "原材料", "采购总金额": 480000, "采购次数": 65, "平均采购金额": 7384.62},
      {"供应商名称": "供应商B", "物料类别": "包装材料", "采购总金额": 350000, "采购次数": 82, "平均采购金额": 4268.29},
      {"供应商名称": "供应商C", "物料类别": "辅料", "采购总金额": 280000, "采购次数": 95, "平均采购金额": 2947.37}
    ]
  },
  "difficulty_factors": {
    "data_quality": "moderate_dirty",
    "field_binding": "exact_match",
    "business_logic": "procurement_analysis",
    "data_volume": "medium"
  },
  "tags": ["medium", "supply_chain", "procurement", "supplier_analysis"]
}
