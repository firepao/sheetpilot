{
  "id": "M2",
  "name": "retail_store_performance",
  "level": "medium",
  "description": "零售门店业绩分析场景，数据包含多个门店多个月份的销售数据",
  "data_file": "tests/agent_contract/data/M2_retail_store.xlsx",
  "source": {
    "sheet": "门店销售",
    "header_row": 1
  },
  "user_prompt": "分析各门店的月度销售业绩，要求：筛选销售额>0的有效记录，按门店名称和月份分组，计算销售额总和、销售笔数和平均客单价，按门店名称升序、销售额降序排列",
  "expected_outcome": "success",
  "ideal_interaction": {
    "rounds": 1,
    "cli_calls": ["task-types", "task-run", "task-status"],
    "expected_bindings": "auto"
  },
  "task_request_template": {
    "filters": [
      {"id": "valid_sales", "field": "销售额", "operator": "gt", "value": 0}
    ],
    "dimensions": [
      {"id": "store", "field": "门店名称", "output_name": "门店名称"},
      {"id": "month", "field": "月份", "output_name": "月份"}
    ],
    "metrics": [
      {"id": "total_sales", "function": "sum", "field": "销售额", "output_name": "销售额总和"},
      {"id": "transaction_count", "function": "count", "mode": "rows", "output_name": "销售笔数"},
      {"id": "avg_price", "function": "average", "field": "销售额", "output_name": "平均客单价"}
    ],
    "sort": [
      {"by": "store", "direction": "asc"},
      {"by": "total_sales", "direction": "desc"}
    ]
  },
  "oracle_params": {
    "method": "pandas_query",
    "filters": "销售额 > 0",
    "group_by": ["门店名称", "月份"],
    "aggregations": {
      "销售额": ["sum", "mean"],
      "销售笔数": "size"
    },
    "sort_by": [
      {"field": "门店名称", "ascending": true},
      {"field": "销售额总和", "ascending": false}
    ],
    "expected_row_count": 36,
    "expected_total": 2400000,
    "sample_rows": [
      {"门店名称": "北京国贸店", "月份": "2024-03", "销售额总和": 95000, "销售笔数": 420, "平均客单价": 226.19},
      {"门店名称": "北京国贸店", "月份": "2024-02", "销售额总和": 88000, "销售笔数": 380, "平均客单价": 231.58},
      {"门店名称": "上海南京路店", "月份": "2024-03", "销售额总和": 92000, "销售笔数": 405, "平均客单价": 227.16}
    ]
  },
  "difficulty_factors": {
    "data_quality": "has_zero_values",
    "field_binding": "exact_match",
    "business_logic": "time_series_by_store",
    "data_volume": "medium"
  },
  "tags": ["medium", "retail", "store_performance", "time_series"]
}
